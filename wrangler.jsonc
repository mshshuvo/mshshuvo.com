// Cloudflare Worker with static assets (Workers Free plan).
// Deployed by .github/workflows/ci.yml after all security checks pass.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mshshuvo",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Email Routing: on the Free plan the Worker can only send to addresses verified in Email Routing.
  "send_email": [
    { "name": "EMAIL" }
  ],
  // Anonymous readiness-check counts: one SQLite-backed Durable Object (free plan).
  "durable_objects": {
    "bindings": [{ "name": "STATS", "class_name": "AssessmentStats" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AssessmentStats"] }
  ],
  // Daily digest of new completions, 13:07 UTC (8:07 Toronto in winter, 9:07 in summer).
  "triggers": { "crons": ["7 13 * * *"] },
  "vars": {
    "CONTACT_FROM": "contact@mshshuvo.com"
  },
  // Secrets (set in the dashboard or with `wrangler secret put`, never committed):
  //   TURNSTILE_SECRET  - Turnstile secret key
  //   CONTACT_TO        - the verified inbox that receives contact messages (kept out of the public repo)
  "observability": { "enabled": true },
  // Custom domains mshshuvo.com and www.mshshuvo.com are live, so the default *.workers.dev
  // URL is off: the site is only reachable through the zone's WAF, bot and rate-limit rules.
  "workers_dev": false,
  "preview_urls": false
}
